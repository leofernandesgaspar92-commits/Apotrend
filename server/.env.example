# ============================================================================
#  ApoPulse — Umgebungsvariablen (Vorlage)
# ============================================================================
#  Diese Datei wird MIT ins Repo eingecheckt und enthaelt deshalb NUR
#  Platzhalter. Die echten Werte gehoeren nach Render → Service → Environment,
#  niemals in eine Datei im Repo. `.env` selbst ist in .gitignore.
#
#  GRUNDREGEL DER ZAHLUNGSWEGE: Ein Anbieter ist nur aktiv, wenn ALLE seine
#  Schluessel gesetzt sind (services/payments.js, buildPaymentProvidersFromEnv).
#  Ein halb konfigurierter Anbieter wird gar nicht angeboten — lieber ein
#  Bezahlweg weniger als ein Knopf, der im Checkout ins Leere fuehrt.
#
#  Alles hier ist OPTIONAL. Ohne eine einzige dieser Variablen startet der
#  Server und laeuft; es fehlen dann die jeweiligen Funktionen, nicht der
#  Dienst.
#
#  ZU DEN PLATZHALTERN IN SPITZEN KLAMMERN: Die stehen so da, damit sie NICHT
#  wie echte Schluessel aussehen. GitHubs Push-Schutz erkennt Schluesselmuster
#  am Aufbau — ein Platzhalter `sk_live_` plus 24 Zeichen wird als echter
#  Stripe-Schluessel gelesen und der Push abgelehnt. Genau das ist beim ersten
#  Versuch passiert. Bitte beim Bearbeiten nicht "realistischer" machen.
# ============================================================================

# ── Betrieb ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# PostgreSQL. Ohne sie laeuft die App aus dem Arbeitsspeicher mit
# Datei-Snapshot — auf Render heisst das: nach jedem Deploy ist alles weg.
# Die INTERNE Adresse verwenden (…-a/apopulse_db), nicht die externe.
DATABASE_URL=<postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANK>

# Signiergeheimnis der Sitzungs-Token. MUSS gesetzt und lang sein; ohne sie
# wird beim Start ein Zufallswert erzeugt und jeder Deploy loggt alle aus.
APOPULSE_TOKEN_SECRET=bitte-ein-langes-zufaelliges-geheimnis-einsetzen

# Erstes Moderations-/Betreiberkonto.
APOPULSE_ADMIN_EMAIL=betreiber@example.com
APOPULSE_ADMIN_PASSWORD=bitte-aendern

# ============================================================================
#  FIAT-ZAHLUNGEN
# ============================================================================

# ── Stripe: Karte, Apple Pay, Google Pay, Klarna ────────────────────────────
#  Apple Pay und Google Pay brauchen KEINE eigenen Schluessel: Sie sind
#  Geldboersen auf derselben Kartenschiene und werden vom gehosteten
#  Stripe-Checkout automatisch angeboten, wenn Geraet und Browser sie koennen.
#
#  Klarna braucht ebenfalls keinen eigenen Schluessel, muss aber im
#  Stripe-Dashboard unter „Payment methods" aktiviert sein — sonst lehnt Stripe
#  die Sitzung mit `payment_method_types[]=klarna` ab.
#
#  KEIN VITE_STRIPE_PUBLIC_KEY und kein Publishable Key: Dieses Projekt nutzt
#  Stripes GEHOSTETEN Checkout. Der Browser wird auf checkout.stripe.com
#  weitergeleitet, Stripe.js laeuft bei uns gar nicht. Ein Publishable Key
#  waere eine Variable, die nichts liest — und ein fremdes Skript auf der
#  Bezahlseite ist Angriffsflaeche, die wir nicht brauchen.
#  (Es gibt hier auch kein Vite: das Frontend sind klassische Skripte ohne
#  Build-Schritt.)
STRIPE_SECRET_KEY=<Stripe Secret Key, beginnt mit sk_live_>
# Aus Stripe → Developers → Webhooks → Endpoint → „Signing secret".
# Endpunkt-Adresse: https://www.apopulse.com/api/payments/webhook/stripe
# Benoetigtes Ereignis: checkout.session.completed
STRIPE_WEBHOOK_SECRET=<Stripe Signing Secret, beginnt mit whsec_>

# ── PayPal: direkt (nicht ueber Stripe) ─────────────────────────────────────
#  Vorrang vor PayPal-via-Stripe (PROVIDER_VORRANG in services/payments.js):
#  guenstiger, und verfuegbar in Maerkten, in denen Stripe es nicht ist.
#
#  ALLE DREI sind Pflicht. Ohne PAYPAL_WEBHOOK_ID laesst sich kein Webhook
#  pruefen, und ein Anbieter, dessen Zahlungsbestaetigungen niemand
#  verifizieren kann, wird nicht angeboten — sonst koennte jeder, der die
#  Adresse kennt, sich mit einem erfundenen „bezahlt" Premium freischalten.
PAYPAL_CLIENT_ID=<PayPal Client ID>
PAYPAL_CLIENT_SECRET=<PayPal Client Secret>
# Aus PayPal Developer → Apps & Credentials → Webhooks → ID des Endpunkts.
# Endpunkt-Adresse: https://www.apopulse.com/api/payments/webhook/paypal
# Benoetigte Ereignisse: CHECKOUT.ORDER.APPROVED und PAYMENT.CAPTURE.COMPLETED
#   (beide! Die Genehmigung loest den Einzug aus, erst der Einzug schaltet
#    frei — siehe handleWebhook.)
PAYPAL_WEBHOOK_ID=<ID des PayPal-Webhook-Endpunkts>
# live | sandbox. Alles andere als live/production/1/true gilt als Sandbox.
PAYPAL_MODE=sandbox

# ============================================================================
#  KRYPTO-ZAHLUNGEN (bleiben dauerhaft, Owner-Vorgabe)
# ============================================================================

# ── Coinbase Commerce: gehosteter Krypto-Checkout ───────────────────────────
#  EUR-Preis rein, der Prozessor rechnet live um und zaehlt Bestaetigungen.
COINBASE_COMMERCE_API_KEY=<Coinbase Commerce API Key>
COINBASE_COMMERCE_WEBHOOK_SECRET=<Coinbase Commerce Shared Secret>

# ── Direkt in die eigene Wallet ─────────────────────────────────────────────
#  OEFFENTLICHE Empfangsadressen, keine Geheimnisse — niemals ein Seed oder
#  ein privater Schluessel. Zahlungen hierueber werden MANUELL geprueft
#  (Kundin reicht die Transaktions-ID ein, Betreiber bestaetigt): Statische
#  Adressen erlauben keine zuverlaessige Zuordnung „wer hat gezahlt".
APOPULSE_WALLET_BTC=
APOPULSE_WALLET_ETH=
APOPULSE_WALLET_SOL_SEEKER=
APOPULSE_WALLET_SOL_PHANTOM=
APOPULSE_WALLET_TRON=
# Kommaliste zusaetzlicher EVM-Netze fuer die Wallet-Anzeige.
APOPULSE_EVM_NETWORKS=

# ============================================================================
#  WEITERES
# ============================================================================

# ── Social Login ────────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── KI-Anreicherung der Live-Meldungen ──────────────────────────────────────
#  Ohne Schluessel laeuft alles weiter, nur ohne Wirkstoff-Extraktion und
#  Uebersetzung (confidenceScore bleibt 0 — ein gueltiger Betriebszustand).
APOPULSE_AI_PROVIDER=anthropic
APOPULSE_AI_API_KEY=
APOPULSE_AI_MODEL=
APOPULSE_AI_TIMEOUT_MS=20000

# ── Android / Play Store (Trusted Web Activity) ─────────────────────────────
#  Erst mit BEIDEN Werten liefert /.well-known/assetlinks.json ein gueltiges
#  Dokument; ohne sie oeffnet die App eine Browserleiste statt Vollbild.
APOPULSE_ANDROID_PACKAGE=com.apopulse.app
APOPULSE_ANDROID_SHA256=

# ── Datenhaltung / Referenzdaten ────────────────────────────────────────────
APOPULSE_DATA_FILE=./data/apopulse.json
# 1 = kuratierte Referenzdaten laden (als REFERENCE gekennzeichnet).
APOPULSE_REFERENCE_DATA=1
# 1 = Demo-Aktionen erzeugen. In Produktion AUS: Demodaten sehen sonst aus wie
# echte Grosshandels-Angebote.
APOPULSE_DEMO_DEALS=0

# ── Ruhende Bereiche einschalten ────────────────────────────────────────────
#  APOPULSE_FEATURE_<ID>=1 weckt einen ruhenden Bereich (data/features.js).
#  Beispiel: APOPULSE_FEATURE_TAUSCHBOERSE=1
