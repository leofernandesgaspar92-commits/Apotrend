// ============================================================================
//  ApoPulse — Datenbankschema
// ============================================================================
//  Grundlage ist der Entwurf des Owners (unverändert abgelegt unter
//  prisma/schema.v1-owner.prisma). Er wurde übernommen, migriert und geprüft.
//
//  Diese Fassung ergänzt ihn an sechs Stellen. Jede Änderung steht unten am
//  jeweiligen Feld begründet; die Übersicht mit Begründung und Rückbau-Hinweis
//  liegt in docs/DATENBANK.md. Nichts davon ist Geschmack — es sind Punkte, an
//  denen der Entwurf mit der laufenden Anwendung kollidiert oder Daten verliert.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
//  Herkunft — der wichtigste Zusatz
// ---------------------------------------------------------------------------
//  Die gesamte Anwendung kennzeichnet, WOHER eine Zahl stammt: geprüfte
//  Behördendaten, kuratierte Referenz, Eigenangabe eines Betriebs oder
//  Demodaten. Ohne dieses Feld sieht eine erfundene Demo-Aktion in der
//  Datenbank exakt aus wie ein echtes Angebot eines echten Großhändlers.
//  Das ist der eine Zusatz, auf dem ich bestehen würde.
enum Provenance {
  VERIFIED      // aus einer amtlichen Quelle übernommen
  REFERENCE     // kuratierte Referenzdaten
  SELF_REPORTED // von einem Fachbetrieb selbst eingetragen
  SIMULATED     // Demodaten — dürfen nie wie echte aussehen
}

// Statuswerte der Anwendung. Vorher ein freier String mit Vorgabe „LIMITED":
// Damit hätte jeder Tippfehler eine neue Statusklasse erzeugt, und die
// deutschen Werte der Anwendung (kritisch/eingeschraenkt/verfuegbar) hätten
// nicht zur Vorgabe gepasst.
enum ShortageStatus {
  CRITICAL   // kritisch — nicht lieferbar
  LIMITED    // eingeschränkt lieferbar
  AVAILABLE  // wieder verfügbar
}

enum TradeType {
  OFFER
  REQUEST
}

// ---------------------------------------------------------------------------
//  Verifizierungsstufen (Jurisdiction-Guard)
// ---------------------------------------------------------------------------
//  Die Stufen benennen, WAS für ein Betrieb bestätigt wurde. Das ist nicht
//  Kosmetik: An ihnen hängt, wer verschreibungspflichtige Angebote sehen darf
//  (domain/jurisdiction.js). In DACH ist Publikumswerbung für Rx-Arzneimittel
//  untersagt (HWG § 10), in den USA gelten FDA-/DSCSA-Vorgaben.
//
//  VERIFIED_LOGISTICS gehört ausdrücklich NICHT zum Rx-Fachkreis: Ein
//  Transportunternehmen befördert Arzneimittel, es erwirbt sie nicht. Die
//  Stufe existiert trotzdem, weil Logistiker eigene Funktionen brauchen
//  (Kapazitäten, Kühlketten-Meldungen) — nur eben keinen Rx-Einblick.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED_PHARMACY
  VERIFIED_WHOLESALE
  VERIFIED_MANUFACTURER
  VERIFIED_LOGISTICS
}

// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  country   String   @default("AT")

  // Kontotyp = WAS für ein Teilnehmer das ist. Bewusst getrennt von der
  // Team-Rolle innerhalb eines Betriebs (admin/apotheker/pta/…), die in
  // domain/roles.js liegt. Ein einziges `role`-Feld würde beide Achsen
  // vermischen — dann wäre „Apotheke" und „Admin" derselbe Begriffsraum.
  role      String   @default("PHARMACY") // PHARMACY, WHOLESALER, PHARMA, AUTHORITY, ADMIN

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // ── Zahlungs-Kundennummern beim Anbieter ──────────────────────────────────
  //  EHRLICHE EINORDNUNG: Diese zwei Felder sind VORGESEHEN, aber noch nicht
  //  gefüllt. Die Konten liegen derzeit im In-Memory-Repo und werden über
  //  AppSnapshot gesichert (siehe dort) — dieses User-Modell wird von der
  //  laufenden Anwendung nicht geschrieben. Sobald die Konten relational
  //  liegen, gehören die Kundennummern hierher und nicht in die
  //  Transaktionszeile: Eine Apotheke hat EINE Kundennummer beim Anbieter und
  //  beliebig viele Zahlungen.
  //
  //  Wer das vorher braucht, findet die Zuordnung in Transaction
  //  (stripeCustomerId je Zahlung) — doppelt geführt, aber nicht erfunden.
  stripeCustomerId String? @unique
  paypalPayerId    String?

  // ── Jurisdiction-Guard ────────────────────────────────────────────────────
  //  Rechtsraum und Verifizierungsstufe. Die DURCHSETZUNG liegt in
  //  domain/jurisdiction.js und läuft bereits — sie leitet die Stufe heute aus
  //  `account_type` + dem von der Moderation bestätigten `verified` ab, weil
  //  die Konten noch nicht relational liegen. Diese Felder sind der Platz, an
  //  den die Angaben gehören, sobald sie es tun.
  //
  //  Dass die Durchsetzung NICHT auf diese Spalten wartet, ist Absicht: Eine
  //  Schranke, die erst mit einer künftigen Datenmigration greift, ist keine.
  jurisdiction       String?            // ISO-3166-1 alpha-2, Großbuchstaben
  verificationStatus VerificationStatus @default(UNVERIFIED)
  licenseNumber      String?            // Betriebserlaubnis-/Lizenznummer

  // Darf verschreibungspflichtige Angebote SEHEN.
  //
  // Bewusst ein eigenes Feld und nicht aus `verificationStatus` abgeleitet:
  // Es ist der Hebel für die Moderation. Ein Betrieb, dessen Erlaubnis
  // erloschen ist, lässt sich sperren, ohne die Verifizierung zurückzunehmen —
  // und ohne die Historie zu verlieren, warum er einmal verifiziert war.
  //
  // Standard `false`: Ein neues Konto sieht kein Rx, bis es bestätigt ist.
  isRxAllowed        Boolean            @default(false)

  posts     Post[]
  discounts Discount[]
  trades    TradeOffer[]
}

// ===========================================================================
//  Zahlungen — FIAT neben Krypto
// ===========================================================================
//  Bezahlweg, den die Kundin GEWÄHLT hat. Bewusst feiner als „CRYPTO / STRIPE
//  / PAYPAL": Zwischen Apple Pay und einer eingetippten Kartennummer liegt für
//  die Auswertung ein Unterschied (Abbruchquote, Gerät), für die Abrechnung
//  nicht — beides läuft über denselben Acquirer. Wer nur die drei Gruppen
//  braucht, bekommt sie über `provider`.
enum PaymentMethod {
  CRYPTO_DIRECT   // eigene Wallet-Adresse, manuell geprüft
  CRYPTO_HOSTED   // über einen Krypto-Prozessor (Coinbase Commerce)
  CARD            // Kredit-/Debitkarte
  APPLE_PAY       // Karte, von Apple Pay verpackt
  GOOGLE_PAY      // Karte, von Google Pay verpackt
  PAYPAL          // PayPal (direkt oder über Stripe — siehe `provider`)
  KLARNA          // Rechnungskauf / Ratenzahlung
  SEPA            // SEPA-Lastschrift
  INVOICE         // Rechnung 30 Tage
}

// Wer das Geld tatsächlich verarbeitet. Das ist die Achse, die für Gebühren,
// Buchhaltung und Rückfragen zählt — nicht der Knopf im Checkout.
enum PaymentProvider {
  DIRECT     // eigene Wallet, kein Dienstleister
  COINBASE
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING         // angelegt, Kundin noch beim Anbieter
  PENDING_REVIEW  // Krypto: Transaktions-ID eingereicht, Prüfung offen
  PAID            // Geld geflossen, Freischaltung erfolgt
  FAILED
  REFUNDED
}

model Transaction {
  id        String @id @default(uuid())

  // ── KEINE Relation auf User, und das ist kein Versehen ───────────────────
  //  Die Konten liegen (noch) nicht in diesem Schema, sondern im
  //  In-Memory-Repo mit AppSnapshot-Sicherung. Ein Fremdschlüssel auf
  //  `User.id` würde deshalb JEDEN Schreibvorgang ablehnen — die Zeile, auf
  //  die er zeigt, existiert in Postgres nicht.
  //
  //  Lieber eine Kennung ohne Zwang als eine Tabelle, in die nichts
  //  hineinpasst. Sobald die Konten relational liegen, wird hieraus eine echte
  //  Relation; der Spaltenname ist deshalb schon der richtige.
  userId    String

  productId String
  feature   String?  // welches Recht freigeschaltet wurde ('premium')

  // Betrag in der kleinsten Währungseinheit (Cent). Ganzzahl statt Decimal:
  // Der Anbieter rechnet selbst in Minor Units, und eine Umrechnung hin und
  // zurück ist eine Rundungsstelle, die es nicht braucht.
  amountMinor Int
  currency    String @default("EUR")

  paymentMethod PaymentMethod
  provider      PaymentProvider
  status        PaymentStatus @default(PENDING)

  // Referenz BEIM ANBIETER (Stripe-Session, Coinbase-Charge, PayPal-Bestellung).
  // Über sie findet der Webhook die Zahlung wieder. @unique: Zweimal dieselbe
  // Anbieter-Referenz wäre ein Zuordnungsfehler, keine zweite Zahlung.
  providerRef   String? @unique

  // Anbieterspezifische Kennungen. Getrennte Spalten statt eines JSON-Feldes,
  // weil nach ihnen gesucht wird, wenn ein Anbieter zurückfragt.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  paypalOrderId        String?
  paypalCaptureId      String?   // erst der Einzug ist Geld, nicht die Genehmigung

  // Krypto-Direktzahlung: welche Wallet, welche Transaktion.
  coin        String?
  walletId    String?
  txRef       String?

  paidAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  // „Alle Zahlungen dieses Betriebs, neueste zuerst" — die Rechnungsansicht.
  @@index([userId, createdAt(sort: Desc)])
  // „Was hängt bei diesem Anbieter offen" — der Blick nach einem Ausfall.
  @@index([provider, status])
  @@index([status, createdAt(sort: Desc)])
}

model NewsPost {
  id          String   @id @default(uuid())
  title       String
  link        String   @unique
  summary     String?
  source      String
  country     String

  // NULLBAR statt Pflicht. Viele Behörden-Feeds liefern kein Datum; der Parser
  // gibt dann bewusst null zurück statt „jetzt" einzusetzen. Mit einem
  // Pflichtfeld müsste die Aufnahme einen Zeitstempel erfinden — und die
  // Meldung rutschte im Feed nach oben, ohne dass es dafür einen Beleg gibt.
  publishedAt DateTime? @db.Timestamptz(3)

  // Welche Quelle sie geliefert hat ('bfarm_news', 'basg_news', …).
  // Erst damit lässt sich eine ausgefallene Quelle im Bestand wiederfinden.
  sourceId    String?
  fetchedAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  // Kein @@index auf [country, publishedAt]: Prisma erzeugt daraus DESC, und
  // DESC heißt in PostgreSQL NULLS FIRST — die Anwendung sortiert aber
  // NULLS LAST. Die Reihenfolgen passen nicht zueinander, der Index konnte
  // deshalb nur den Länderfilter bedienen und PostgreSQL sortierte nach.
  // Der passende Index steht als rohes SQL in der Migration
  // 20260830161000_newspost_publishedat_nulls_last (Prismas @@index kennt
  // keine NULLS-Angabe).
  //
  // Der Index hier deckt eine ANDERE Frage ab: „was ist seit gestern für DE
  // dazugekommen" — der Blick nach einem Ausfall oder Neustart. Dafür ist
  // `createdAt` die richtige Spalte, weil sie immer gesetzt ist, während
  // `publishedAt` bei einem Teil der Meldungen leer bleibt.
  @@index([country, createdAt(sort: Desc)])
  @@index([sourceId])
}

model Shortage {
  id          String   @id @default(uuid())
  drugName    String
  activeSubst String?
  country     String

  status      ShortageStatus @default(LIMITED)
  reason      String?
  source      String
  provenance  Provenance     @default(REFERENCE)

  reportedAt  DateTime? @db.Timestamptz(3)  // gemeldet am
  expectedEnd DateTime? @db.Timestamptz(3)  // voraussichtlich bis

  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  // Der Duplikat-Schutz aus dem Entwurf — unverändert übernommen und geprüft:
  // zweimal dasselbe Präparat im selben Land ergibt eine Zeile mit
  // aktualisiertem Status.
  @@unique([drugName, country])
  @@index([country, status])
  @@index([activeSubst])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  country   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([country, createdAt(sort: Desc)])
}

model Discount {
  id          String   @id @default(uuid())
  title       String
  description String

  // Preise statt nur Prozent. Der Entwurf speicherte ausschließlich
  // `discountPct` — damit lässt sich „2,35 € → 1,65 €" nicht mehr anzeigen,
  // die Ersparnis je Packung nicht berechnen und die Angabe nicht überprüfen.
  // Decimal statt Float: Float rechnet 1.1 + 2.2 zu 3.3000000000000003, und
  // das ist bei Geldbeträgen keine Kleinigkeit.
  listPrice   Decimal  @db.Decimal(10, 2)
  dealPrice   Decimal  @db.Decimal(10, 2)
  currency    String   @default("EUR")
  discountPct Float    // abgeleitet, für Sortierung und Anzeige
  minQuantity Int?

  // Ohne Enddatum ist nicht feststellbar, ob eine Aktion noch läuft — die
  // Top-10-Ansicht der Anwendung zeigt ausschließlich laufende.
  validUntil  DateTime @db.Timestamptz(3)

  country     String
  provenance  Provenance @default(SELF_REPORTED)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([country, validUntil])
  @@index([authorId])
}

model TradeOffer {
  id           String    @id @default(uuid())
  productName  String
  quantity     Int
  pricePerUnit Decimal?  @db.Decimal(10, 2)
  currency     String    @default("EUR")

  // Aus dem Kommentar „OFFER oder REQUEST" wird eine Regel: Als freier String
  // wäre „Offer", „offer" und „ANGEBOT" derselbe Fachbegriff in drei
  // Schreibweisen — und keine Abfrage fände alle.
  tradeType    TradeType

  country      String
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([country, tradeType, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
//  Gesamtzustand als Sicherung
// ---------------------------------------------------------------------------
//  EHRLICHE EINORDNUNG: Das hier ist ein Zwischenschritt, keine schöne Lösung.
//  Es speichert den kompletten Anwendungszustand als EINEN gepackten Blob —
//  nicht abfragbar, nicht relational, kein Ersatz für richtige Tabellen.
//
//  Warum trotzdem: Auf dem kostenlosen Render-Tarif ist das Dateisystem
//  flüchtig. Nach jedem Deploy waren nicht nur die News weg, sondern JEDES
//  KONTO — jede Apotheke hätte sich neu registrieren müssen. Die Alternative
//  wäre, sämtliche Repos (Konten, Profile, Beiträge, Nachrichten,
//  Bestellungen, Moderation) in einem Zug auf Prisma umzuhängen. Das ist ein
//  Umbau mit hohem Risiko an der Anmeldung, und er hätte gedauert, während
//  jeder Deploy weiter alles gelöscht hätte.
//
//  Dieser Blob nutzt denselben __dump()/__load()-Vertrag, der für den
//  JSON-Snapshot bereits getestet ist. Er löst das akute Problem heute; die
//  relationale Ablage (News und Engpässe liegen schon so) kann Modell für
//  Modell nachziehen, ohne dass zwischendurch Daten verloren gehen.
model AppSnapshot {
  // Immer 'main' — eine einzige Zeile, die überschrieben wird. Eine Historie
  // wäre hier kein Gewinn: Der Zustand ist nur als Ganzes sinnvoll, und
  // wachsende Kopien eines Megabyte-Blobs füllen still die Datenbank.
  id        String   @id @default("main")

  // Gzip-gepacktes JSON. Als Bytes statt Json/Text: Der Inhalt wird nie in der
  // Datenbank durchsucht, und gepackt sind es rund 30 % der Rohgröße.
  data      Bytes

  rawSize   Int      // Rohgröße in Bytes — macht Wachstum sichtbar
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ===========================================================================
//  VerifiedSignal — eine Meldung aus einer amtlichen Quelle, strukturiert
// ===========================================================================
//  Das universelle Modell für ALLE eingehenden Live-Meldungen, egal ob
//  Engpass, Rückruf, Regulatorik oder Nachricht. Es löst NewsPost/Shortage
//  nicht ab, sondern liegt darunter: Dort stand bisher je Datentyp eine eigene
//  Tabelle, und jede neue Quelle brauchte eine eigene Zuordnung.
//
//  ─────────────────────────────────────────────────────────────────────────
//  DIE REGEL, DIE DIESES MODELL TRÄGT
//  ─────────────────────────────────────────────────────────────────────────
//  `originalUrl` und `sourceName` kommen NIEMALS aus der KI. Sie stammen
//  mechanisch aus dem Abruf: Welche Adresse wurde geholt, welche Quelle steht
//  dahinter. Eine KI, die eine Quelle „erkennt", erfindet im Zweifel eine
//  plausible — und dann steht unter einer Engpassmeldung ein Behördenname, der
//  nie etwas dazu gesagt hat. Bei Engpässen wird danach umbestellt.
//
//  Die KI darf: zusammenfassen, übersetzen, Wirkstoff und Schweregrad
//  vorschlagen. Sie darf NICHT: die Herkunft bestimmen.
//
//  `confidenceScore` bezieht sich deshalb ausschließlich auf die KI-Extraktion,
//  nie auf die Echtheit der Quelle. 0 heißt „keine KI gelaufen" — das ist ein
//  gültiger Betriebszustand, kein Fehler (siehe services/aiExtract.js).
// ===========================================================================
model VerifiedSignal {
  id            String   @id @default(uuid())

  // Stabile Kennung für die Doppelerkennung: Quelle + Original-Adresse.
  // Ein erneuter Durchlauf derselben Meldung aktualisiert die Zeile, statt
  // eine zweite anzulegen — sonst wächst der Feed bei jedem Abruf.
  dedupeKey     String   @unique

  title         String
  summary       String?

  // ── Herkunfts-Proof: mechanisch, nie aus der KI ──
  originalUrl   String
  sourceName    String
  sourceId      String?

  country       String   // ISO-3166-1 alpha-2, Großbuchstaben
  language      String   @default("de")
  category      String   // SHORTAGE | REGULATORY | RECALL | NEWS

  // ── Von der KI vorgeschlagen (oder null, wenn keine KI lief) ──
  wirkstoff     String?  // INN
  handelsname   String?
  schweregrad   String?  // kritisch | eingeschraenkt | verfuegbar | unbekannt
  ursache       String?
  gueltigVon    DateTime? @db.Timestamptz(3)
  gueltigBis    DateTime? @db.Timestamptz(3)

  // Übersetzte Zusammenfassungen. Fehlt eine Sprache, zeigt das Frontend die
  // Originalfassung — ausdrücklich keine Platzhalter-Übersetzung.
  summaryDe     String?
  summaryEn     String?
  summaryPt     String?

  // Rohtext der Quelle. Gekürzt gespeichert: Er dient der Nachvollziehbarkeit
  // („was stand da wirklich"), nicht der Volltextsuche.
  rawPayload    String?

  // 0.0–1.0, NUR für die KI-Extraktion. 0 = keine KI gelaufen.
  confidenceScore Float  @default(0)

  // Wann der Abruf diese Meldung gesehen hat — nicht, wann die Behörde sie
  // veröffentlicht hat (das ist `publishedAt`).
  verifiedAt    DateTime @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Die Hauptabfrage des Frontends: „Was gibt es für MEIN Land in DIESER
  // Kategorie, neueste zuerst." Ein Index auf alle drei Spalten in dieser
  // Reihenfolge bedient sie vollständig aus dem Index.
  @@index([country, category, verifiedAt(sort: Desc)])
  // Zweithäufigste Frage: „Alles zu diesem Wirkstoff" — über Ländergrenzen.
  @@index([wirkstoff, verifiedAt(sort: Desc)])
  // Für die Statusanzeige je Land ohne Kategoriefilter.
  @@index([country, verifiedAt(sort: Desc)])
}
