{
  "name": "apopulse-desktop",
  "version": "1.0.0",
  "description": "ApoPulse Desktop — Electron-Hülle um denselben Web-Kern wie die PWA (frontend/index.html). Additiv, verändert die Mobile-Version nicht.",
  "private": true,
  "author": "ApoPulse <noreply@apopulse.at>",
  "homepage": "https://leofernandesgaspar92-commits.github.io/ApoPulse/",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "at.apopulse.desktop",
    "productName": "ApoPulse",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "../frontend", "to": "frontend" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
