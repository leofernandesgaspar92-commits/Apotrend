# ============================================================================
#  ApoPulse B2C — Umgebungsvariablen
# ============================================================================

# Schlüssel für Gesundheitsdaten (Art. 9 DSGVO), 32 Byte base64-kodiert.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# OHNE diesen Schlüssel startet die Anwendung in Produktion NICHT (bewusst):
# ein Entwicklungsschlüssel in Produktion wäre schlimmer als gar keine
# Verschlüsselung, weil er ein falsches Sicherheitsgefühl erzeugt.
# In echt gehört der Schlüssel in KMS/Vault, nicht in eine Datei.
APOPULSE_HEALTH_KEY_V1=

# Version, mit der NEUE Datensätze verschlüsselt werden. Für eine Rotation:
# APOPULSE_HEALTH_KEY_V2 setzen, dann diesen Wert auf 2 erhöhen. Alte Daten
# bleiben mit V1 lesbar — keine Migration nötig.
APOPULSE_HEALTH_KEY_CURRENT=1

# Salt für IP-Hashes in Einwilligungsnachweisen (verhindert Rückrechnung).
APOPULSE_IP_SALT=
