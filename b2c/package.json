{
  "name": "apopulse-b2c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ApoPulse B2C — Social-Commerce & Telemedizin (Greenfield-Track)",
  "scripts": {
    "build:tokens": "node tools/build-tokens.mjs",
    "check:tokens": "node tools/build-tokens.mjs --check",
    "check:contrast": "node tools/check-contrast.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "verify": "npm run check:tokens && npm run check:contrast && npm run check:media && npm run test && npm run typecheck",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check:e2e": "node tools/with-server.mjs",
    "check:e2e:manual": "node tools/e2e-check.mjs",
    "verify:all": "npm run verify && npm run build && npm run check:e2e",
    "media": "node tools/make-demo-media.mjs",
    "check:media": "node tools/make-demo-media.mjs --check"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "playwright": "^1.47.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
